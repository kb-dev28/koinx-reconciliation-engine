{
  "info": {
    "_postman_id": "45bb01f8-7b92-49ec-b557-8ee7083721fa",
    "name": "KoinX Reconciliation Engine",
    "description": "API collection for the KoinX reconciliation engine. Start the server (`npm start`), run **POST Reconcile**, then copy `runId` into the collection variable before calling the report endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "runId",
      "value": "",
      "description": "Paste here the runId returned by POST /reconcile"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "POST Reconcile",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/reconcile",
        "description": "Runs ingestion + matching using default CSVs in `samples/`. Copy `runId` from the response into the `runId` collection variable."
      }
    },
    {
      "name": "GET Report (CSV)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/report/{{runId}}",
        "description": "Downloads the full reconciliation report as CSV."
      }
    },
    {
      "name": "GET Summary",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/report/{{runId}}/summary"
      }
    },
    {
      "name": "GET Unmatched",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/report/{{runId}}/unmatched"
      }
    }
  ]
}
